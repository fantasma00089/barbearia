// ───────────────────────────────────────────────────────────────
// Navalha & Arte — modelo de dados
//
// Desenvolvimento: SQLite (arquivo local).
// Produção: troque `provider` para "postgresql" e ajuste DATABASE_URL.
// O schema evita recursos exclusivos de um banco (enums nativos, tipos
// especiais), então a migração é só trocar o provider e gerar a migration.
// Valores "enum" são strings validadas com Zod em `lib/validation`.
// ───────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  /// HAIR | BEARD | COMBO | CHEMICAL | KIDS
  category    String
  durationMin Int
  /// Preço em centavos (evita erros de ponto flutuante)
  priceCents  Int
  /// true = "a partir de" (preço pode variar)
  priceFrom   Boolean  @default(false)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  barbers  BarberService[]
  bookings Booking[]

  @@index([category, active])
}

model Barber {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  nickname        String?
  specialty       String
  bio             String
  yearsExperience Int
  rating          Float    @default(5)
  reviewsCount    Int      @default(0)
  /// Caminho em /public ou URL absoluta
  photo           String
  instagram       String?
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  services BarberService[]
  bookings Booking[]
  blocks   TimeBlock[]
}

model BarberService {
  barberId  String
  serviceId String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@index([serviceId])
}

/// Horário de funcionamento por dia da semana (0 = domingo ... 6 = sábado).
/// Horas no formato "HH:mm", no fuso configurado em config/business.ts.
model BusinessHour {
  dayOfWeek  Int     @id
  isOpen     Boolean @default(true)
  openTime   String  @default("09:00")
  closeTime  String  @default("20:00")
  /// Pausa opcional (ex.: almoço). Ambos nulos = sem pausa.
  breakStart String?
  breakEnd   String?
}

model Booking {
  id            String   @id @default(cuid())
  /// Código público da reserva (ex.: NA-7K3F9Q)
  code          String   @unique
  serviceId     String
  barberId      String
  customerName  String
  /// Somente dígitos, com DDD (ex.: 69999990000)
  customerPhone String
  notes         String?
  /// Sempre em UTC. Exibição convertida para o fuso da barbearia.
  startAt       DateTime
  endAt         DateTime
  /// PENDING | CONFIRMED | CANCELLED | COMPLETED | NO_SHOW
  status        String   @default("PENDING")
  /// Snapshot do serviço no momento da reserva
  priceCents    Int
  durationMin   Int
  /// true quando o cliente escolheu "sem preferência"
  anyBarber     Boolean  @default(false)

  rescheduleRequested Boolean   @default(false)
  rescheduleNote      String?
  rescheduleAt        DateTime?

  cancelledAt  DateTime?
  /// CUSTOMER | ADMIN
  cancelledBy  String?
  cancelReason String?
  confirmedAt  DateTime?

  /// Preparado para Pix: NOT_REQUIRED | PENDING | PAID | REFUNDED | FAILED
  paymentStatus String @default("NOT_REQUIRED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service  Service   @relation(fields: [serviceId], references: [id])
  barber   Barber    @relation(fields: [barberId], references: [id])
  payments Payment[]

  @@index([barberId, startAt])
  @@index([startAt, status])
  @@index([customerPhone])
}

/// Bloqueio de agenda (folga, evento, manutenção).
/// barberId nulo = bloqueia a barbearia inteira.
model TimeBlock {
  id        String   @id @default(cuid())
  barberId  String?
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())

  barber Barber? @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([startAt, endAt])
}

/// Estrutura reservada para pagamentos (Pix). Ainda não utilizada pela UI.
/// Veja server/payments/README.md.
model Payment {
  id           String    @id @default(cuid())
  bookingId    String
  /// ex.: "pix"
  method       String
  /// ex.: "none", "mercadopago", "efi", "asaas"
  provider     String
  /// PENDING | PAID | EXPIRED | REFUNDED | FAILED
  status       String    @default("PENDING")
  amountCents  Int
  externalId   String?   @unique
  pixCopyPaste String?
  pixQrCodeUrl String?
  expiresAt    DateTime?
  paidAt       DateTime?
  rawPayload   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}
