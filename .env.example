# ───────────────────────────────────────────────────────────────
# Navalha & Arte Barber Shop — variáveis de ambiente
# Copie para `.env` e ajuste os valores:  cp .env.example .env
# ───────────────────────────────────────────────────────────────

# Banco de dados
# Desenvolvimento (SQLite local, arquivo criado em prisma/dev.db):
DATABASE_URL="file:./dev.db"
# Produção (PostgreSQL) — veja a seção "Migrar para PostgreSQL" no README:
# DATABASE_URL="postgresql://usuario:senha@host:5432/barbearia?schema=public"

# URL pública do site (sem barra no final). Usada em SEO, sitemap e Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Painel administrativo (/admin)
# Use uma senha forte (mínimo 8 caracteres).
ADMIN_PASSWORD="troque-esta-senha"
# Segredo para assinar o cookie de sessão do admin (mínimo 32 caracteres).
# Gere com:  openssl rand -base64 48
ADMIN_SESSION_SECRET="troque-por-um-segredo-longo-e-aleatorio-com-32+-caracteres"

# Conteúdo de demonstração
# "false" = o seed não cria reservas fictícias (use em produção).
SEED_DEMO_BOOKINGS="true"
# "true" = esconde os avisos "imagem ilustrativa / dados fictícios" do site.
NEXT_PUBLIC_HIDE_DEMO_NOTES="false"

# Pagamentos (reservado para integração futura com Pix — ainda não utilizado)
# PAYMENT_PROVIDER="none"
# PIX_API_KEY=""
# PIX_WEBHOOK_SECRET=""
